Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", 
    RowBox[{"==", 
     RowBox[{"==", 
      RowBox[{"==", 
       RowBox[{
       "===", "===", "===", "===", "===", "===", "===", "===", "=="}]}]}]}]}],
    "*)"}], 
  RowBox[{"(*", 
   RowBox[{"6.", " ", "Drain", " ", "Resistance"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
    RowBox[{"==", 
     RowBox[{"==", 
      RowBox[{
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
       "=="}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"rdValues", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "curve", ",", "fitData", ",", "fitLine", ",", "slope", ",", 
           "nFit"}], "}"}], ",", 
         RowBox[{
          RowBox[{"curve", "=", 
           RowBox[{"SortBy", "[", 
            RowBox[{
             RowBox[{"getCurve", "[", 
              RowBox[{"key", ",", "\"\<VDS\>\"", ",", "\"\<IDS\>\""}], "]"}], 
             ",", "First"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"nFit", "=", 
           RowBox[{"Max", "[", 
            RowBox[{"4", ",", 
             RowBox[{"Ceiling", "[", 
              RowBox[{"0.25", " ", 
               RowBox[{"Length", "[", "curve", "]"}]}], "]"}]}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"fitData", "=", 
           RowBox[{"Take", "[", 
            RowBox[{"curve", ",", 
             RowBox[{"-", "nFit"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"fitLine", "=", 
           RowBox[{"LinearModelFit", "[", 
            RowBox[{"fitData", ",", "x", ",", "x"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"slope", "=", 
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{"Normal", "[", "fitLine", "]"}], ",", "x"}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"NumericQ", "[", "slope", "]"}], "&&", 
             RowBox[{"slope", ">", "0"}]}], ",", 
            RowBox[{"1", "/", "slope"}], ",", "Indeterminate"}], "]"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"key", ",", "sortedKeys"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rdMaximum", "=", "100000"}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{"100", " ", "k\[CapitalOmega]"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rdData", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"VGSvalues", ",", "rdValues"}], "}"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"NumericQ", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "&&", 
         RowBox[{"Positive", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "&&", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "<", "rdMaximum"}]}], "&"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rdfunction", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"SortBy", "[", 
        RowBox[{"rdData", ",", "First"}], "]"}], ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rdPlot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"rdData", ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"Axes", "->", "False"}], ",", 
       RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\(V\\), \\(GS\\)]\\) (V)\>\"", 
          
          ",", "\"\<\\!\\(\\*SubscriptBox[\\(r\\), \\(d\\)]\\) (\
\[CapitalOmega])\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"sampleName", "<>", "\"\< Drain Resistance\>\""}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Blue", ",", "Thick"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"ImageSize", "->", "700"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "rdPlot"}]}]], "Input",
