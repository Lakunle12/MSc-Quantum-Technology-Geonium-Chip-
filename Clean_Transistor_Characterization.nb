Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "=="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"3.", " ", "Shockley", " ", "Curve"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "=="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"VDSbias", "=", "4.0"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"transferData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"curve", ",", "point"}], "}"}], ",", 
         RowBox[{
          RowBox[{"curve", "=", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"data", "[", "key", "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", 
                 RowBox[{"cols", "[", "\"\<VDS\>\"", "]"}]}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"data", "[", "key", "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", 
                 RowBox[{"cols", "[", "\"\<IDS\>\"", "]"}]}], "]"}], "]"}]}], 
             "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"point", "=", 
           RowBox[{"First", "@", 
            RowBox[{"Nearest", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"curve", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}], "->", "curve"}], ",",
               "VDSbias"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"meanValue", "[", 
             RowBox[{"key", ",", "\"\<VGS\>\""}], "]"}], ",", 
            RowBox[{
             RowBox[{"point", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "*", 
             RowBox[{"10", "^", 
              RowBox[{"-", "3"}]}]}]}], "}"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"key", ",", "sortedKeys"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"shockleyFitData", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"transferData", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"NumericQ", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "&&", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ">", "0"}]}], "&"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"shockleyFit", "=", 
     RowBox[{"NonlinearModelFit", "[", 
      RowBox[{"shockleyFitData", ",", 
       RowBox[{"IDSSparameter", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"v", "/", "Vpparameter"}]}], ")"}], "^", "2"}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"IDSSparameter", ",", 
           RowBox[{"Max", "[", 
            RowBox[{"shockleyFitData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Vpparameter", ",", 
           RowBox[{"-", "1.4"}]}], "}"}]}], "}"}], ",", "v"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"IDSS", "=", 
     RowBox[{"IDSSparameter", "/.", " ", 
      RowBox[{"shockleyFit", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Vp", "=", 
     RowBox[{"Vpparameter", "/.", " ", 
      RowBox[{"shockleyFit", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"shockleyPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{"shockleyFitData", ",", 
         RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
         RowBox[{"PlotStyle", "->", "Red"}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"shockleyFit", "[", "v", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", ",", 
           RowBox[{"Min", "[", "VGSvalues", "]"}], ",", 
           RowBox[{"Max", "[", "VGSvalues", "]"}]}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Blue", ",", "Thick"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"Axes", "->", "False"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\(V\\), \\(GS\\)]\\) (V)\>\"", 
          ",", "\"\<\\!\\(\\*SubscriptBox[\\(I\\), \\(DS\\)]\\) (A)\>\""}], 
         "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"sampleName", "<>", "\"\< Shockley Curve\>\""}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"ImageSize", "->", "700"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]",
    "shockleyPlot", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\(I\\), \\(DSS\\)]\\) = \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"1000", " ", "IDSS"}], ",", 
        RowBox[{"{", 
         RowBox[{"7", ",", "3"}], "}"}]}], "]"}], ",", "\"\< mA\>\""}], "]"}],
