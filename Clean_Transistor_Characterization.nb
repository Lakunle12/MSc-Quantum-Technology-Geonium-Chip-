   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Helper", " ", "Functions"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"getCurve", "[", 
      RowBox[{"key_", ",", "x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xdata", ",", "ydata"}], "}"}], ",", 
       RowBox[{
        RowBox[{"xdata", "=", 
         RowBox[{
          RowBox[{"data", "[", "key", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"cols", "[", "x", "]"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ydata", "=", 
         RowBox[{
          RowBox[{"data", "[", "key", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"cols", "[", "y", "]"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"y", "===", "\"\<IDS\>\""}], "||", 
           RowBox[{"y", "===", "\"\<IGS\>\""}]}], ",", 
          RowBox[{"ydata", "=", 
           RowBox[{"ydata", "/", "1000"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Transpose", "[", 
