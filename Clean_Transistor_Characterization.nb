Cell[CellGroupData[{

Cell["Source Follower Self - bias operation", "Subsection",
 CellChangeTimes->{{3.992760245490116*^9, 
  3.992760261579927*^9}},ExpressionUUID->"aa8193de-535e-4c11-953f-\
c9e65a44583f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", "===", "===", "===", "===", "===", "===", "===", 
    RowBox[{"==", 
     RowBox[{"==", 
      RowBox[{"==", 
       RowBox[{"==", 
        RowBox[{"==", 
         RowBox[{"==", 
          RowBox[{"==", 
           RowBox[{
           "===", "===", "===", "===", "===", "===", "=="}]}]}]}]}]}]}]}]}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"JFET", " ", "Self"}], "-", 
    RowBox[{"Bias", " ", "Source", " ", "Follower", " ", "Operation"}]}], 
   "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{"===", "===", "===", "===", "===", "===", 
    RowBox[{"==", 
     RowBox[{"==", 
      RowBox[{"==", 
       RowBox[{
       "===", "===", "===", "===", "===", "===", "===", "=="}]}]}]}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "JFETSelfBiasSourceFollowerOperation", "]"}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"JFETSelfBiasSourceFollowerOperation", "[", 
      RowBox[{
      "VDD_", ",", "RF_", ",", "RG_", ",", "RS_", ",", "RL_", ",", "fit_", ",",
        "rdVGSFunction_", ",", "VpFit_", ",", "IDSSFit_", ",", 
       RowBox[{"PrintResults_", ":", "True"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "ID", ",", "VGS", ",", "VG", ",", "VS", ",", "VD", ",", "VDS", ",", 
         "gmValue", ",", "rdValue", ",", "VoltageGain", ",", "Zin", ",", 
         "Zout", ",", "ChannelNoise", ",", "PDC"}], "}"}], ",", 
       RowBox[{
        RowBox[{"VG", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Solve", " ", "the", " ", "self"}], "-", 
          RowBox[{"bias", " ", "operating", " ", "point"}]}], "*)"}], 
        RowBox[{"VS", "=", 
         RowBox[{"v", "/.", " ", 
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{"v", "==", 
             RowBox[{"RS", " ", 
              RowBox[{"fit", "[", 
               RowBox[{"-", "v"}], "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"v", ",", 
              RowBox[{
               RowBox[{"-", "0.9"}], " ", "VpFit"}], ",", "0", ",", 
              RowBox[{"-", "VpFit"}]}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"VGS", "=", 
         RowBox[{"VG", "-", "VS"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ID", "=", 
         RowBox[{"fit", "[", "VGS", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ID", "<=", "0"}], "||", 
           RowBox[{"ID", ">=", "IDSSFit"}]}], ",", 
          RowBox[{
          "Return", 
           "[", "\"\<Calculated drain current is outside 0 < ID < IDSS.\>\"", 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"VD", "=", 
         RowBox[{"VDD", "-", 
          RowBox[{"ID", " ", "RF"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"VDS", "=", 
         RowBox[{"VD", "-", "VS"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Small", "-", 
          RowBox[{"signal", " ", "transistor", " ", "parameters"}]}], "*)"}], 
        
        RowBox[{"gmValue", "=", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"fit", "[", "x", "]"}], ",", "x"}], "]"}], "/.", " ", 
          RowBox[{"x", "->", "VGS"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rdValue", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"NumberQ", "[", "rdVGSFunction", "]"}], ",", 
           "rdVGSFunction", ",", 
           RowBox[{"rdVGSFunction", "[", "VGS", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Source", "-", 
          RowBox[{"follower", " ", "performance"}]}], "*)"}], 
        RowBox[{"VoltageGain", "=", 
         RowBox[{"gmValue", "/", 
          RowBox[{"(", 
           RowBox[{"gmValue", "+", 
            RowBox[{"1", "/", "RS"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"RF", "/", "RS"}]}], ")"}], "/", "rdValue"}]}], 
           ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Zin", "=", "RG"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Zout", "=", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"1", "/", "RS"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"gmValue", " ", "rdValue"}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"RF", "+", "rdValue"}], ")"}]}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"FET", " ", "channel"}], "-", 
          RowBox[{
          "noise", " ", "density", " ", "at", " ", "4.2", " ", "K"}]}], 
         "*)"}], 
        RowBox[{"ChannelNoise", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"4", "*", "1.380649", "*", 
           RowBox[{"10", "^", 
            RowBox[{"-", "23"}]}], "*", "4.2", "*", 
           RowBox[{"(", 
            RowBox[{"2", "/", 
             RowBox[{"(", 
              RowBox[{"3", " ", "gmValue"}], ")"}]}], ")"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"DC", " ", "supply", " ", "power"}], "*)"}], 
        RowBox[{"PDC", "=", 
         RowBox[{"VDD", " ", "ID"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"PrintResults", ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<JFET Self-Bias Source Follower Operation\>\"", ",", 
              "14", ",", "Bold"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\(I\\), \\(D\\)]\\) = \>\"", ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"1000", " ", "ID"}], ",", 
               RowBox[{"{", 
                RowBox[{"7", ",", "3"}], "}"}]}], "]"}], 
             ",", "\"\< mA    \>\"", 
             ",", "\"\<\\!\\(\\*SubscriptBox[\\(V\\), \\(DS\\)]\\) = \>\"", ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"VDS", ",", 
               RowBox[{"{", 
                RowBox[{"7", ",", "3"}], "}"}]}], "]"}], ",", "\"\< V\>\""}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\(V\\), \\(GS\\)]\\) = \>\"", 
             ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"VGS", ",", 
               RowBox[{"{", 
                RowBox[{"7", ",", "3"}], "}"}]}], "]"}], ",", "\"\< V    \>\"",
              ",", "\"\<\\!\\(\\*SubscriptBox[\\(V\\), \\(G\\)]\\) = \>\"", ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"VG", ",", 
               RowBox[{"{", 
                RowBox[{"6", ",", "3"}], "}"}]}], "]"}], ",", "\"\< V    \>\"",
              ",", "\"\<\\!\\(\\*SubscriptBox[\\(V\\), \\(S\\)]\\) = \>\"", ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"VS", ",", 
               RowBox[{"{", 
                RowBox[{"7", ",", "3"}], "}"}]}], "]"}], ",", "\"\< V\>\""}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\(V\\), \\(D\\)]\\) = \>\"", ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"VD", ",", 
               RowBox[{"{", 
                RowBox[{"7", ",", "3"}], "}"}]}], "]"}], ",", "\"\< V\>\""}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\(g\\), \\(m\\)]\\) = \>\"", ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"1000", " ", "gmValue"}], ",", 
               RowBox[{"{", 
                RowBox[{"7", ",", "3"}], "}"}]}], "]"}], 
             ",", "\"\< mS    \>\"", 
             ",", "\"\<1/\\!\\(\\*SubscriptBox[\\(g\\), \\(m\\)]\\) = \>\"", ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"1", "/", "gmValue"}], ",", 
               RowBox[{"{", 
